{
  "name": "agyflux",
  "version": "1.0.0",
  "description": "Minimalist Antigravity subscription & account switcher with physical spring motion",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test",
    "test:backend": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib -- --test-threads=1",
    "check:backend": "cargo check --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:debug": "RUST_LOG=debug npm run tauri dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.7",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "motion": "^12.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.0",
    "react-router": "^7.10.1",
    "react-router-dom": "^7.10.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
